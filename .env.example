# Local Docker environment. Copy to .env only when you need to override ports or credentials.
POSTGRES_DB=seo_agent
POSTGRES_USER=seo_agent
POSTGRES_PASSWORD=change-this-before-any-nonlocal-deployment
POSTGRES_PORT=5432
REDIS_PORT=6379
PLATFORM_API_PORT=8010
APP_ENV=development

# Optional: let the existing http://127.0.0.1:8000 workspace deliver long
# jobs through Redis/Celery. Use the same token in the workspace process.
SEO_TASK_QUEUE_BACKEND=local
SEO_LOCAL_WORKER_CONCURRENCY=2
SEO_WORKER_TOKEN=change-this-to-a-long-random-value
SEO_WORKSPACE_CALLBACK_URL=http://host.docker.internal:8000

# P6.8 runtime database control. Production cutover must first pass the
# persisted full-data, foreign-key, vault, queue, and shadow-read gates.
SEO_RUNTIME_DATABASE_MODE=sqlite
# DATABASE_URL=postgresql://seo_agent:replace-me@127.0.0.1:5432/isolated_rehearsal
# SEO_RUNTIME_SWITCH_STATE_PATH=./data/runtime-database-state.json
